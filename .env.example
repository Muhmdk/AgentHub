# Safe local defaults. Copy this file to .env only when you need overrides.
AGENTHUB_ENVIRONMENT=local
AGENTHUB_LOG_LEVEL=INFO
AGENTHUB_API_HOST=127.0.0.1
AGENTHUB_API_PORT=8000
# Gateway calls in local mode require X-AgentHub-Identity: local/<name>.
# Staging and production load a JSON identity-to-token map from a secret store.
# AGENTHUB_GATEWAY_SERVICE_TOKENS={"service/deployment-smoke":"replace-with-32-plus-secret-characters"}
AGENTHUB_MODEL_PROVIDER=fake
AGENTHUB_RETRIEVAL_PROVIDER=local
AGENTHUB_AGENT_MAX_STEPS=3
AGENTHUB_TOOL_TIMEOUT_SECONDS=1.0
AGENTHUB_AGENT_TIMEOUT_SECONDS=5.0
AGENTHUB_RAG_TOP_K=3
AGENTHUB_RAG_MINIMUM_SCORE=0.15
AGENTHUB_RETRIEVAL_TIMEOUT_SECONDS=5.0
AGENTHUB_OTEL_ENABLED=false
AGENTHUB_OTEL_EXPORTER=otlp
AGENTHUB_OTEL_ENDPOINT=http://127.0.0.1:4318
AGENTHUB_OTEL_EXPORT_INTERVAL_MS=5000
AGENTHUB_OTEL_MAX_QUEUE_SIZE=256
AGENTHUB_OBSERVABILITY_GRAFANA_URL=http://127.0.0.1:3000
AGENTHUB_DATABASE_URL=postgresql+psycopg://agenthub:agenthub@127.0.0.1:5433/agenthub
AGENTHUB_DATABASE_AUTH_MODE=password

# Azure providers are opt-in. Workload identity supplies credentials; do not add secrets here.
# AGENTHUB_MODEL_PROVIDER=azure-openai
# AGENTHUB_RETRIEVAL_PROVIDER=azure-search
# AGENTHUB_AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AGENTHUB_AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
# AGENTHUB_AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AGENTHUB_AZURE_OPENAI_INPUT_COST_PER_MILLION=0
# AGENTHUB_AZURE_OPENAI_OUTPUT_COST_PER_MILLION=0
# AGENTHUB_AZURE_SEARCH_ENDPOINT=https://example.search.windows.net
# AGENTHUB_AZURE_SEARCH_INDEX_NAME=agenthub-chunks-v1
# AGENTHUB_AZURE_REQUEST_TIMEOUT_SECONDS=10
# AGENTHUB_DATABASE_AUTH_MODE=azure-workload-identity
# AGENTHUB_OTEL_EXPORTER=azure-monitor
# AGENTHUB_AZURE_MONITOR_CONNECTION_STRING=load-from-key-vault-at-runtime
