{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "httpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 10 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "automountToken", "annotations", "labels"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountToken": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "logLevel",
        "modelProvider",
        "retrievalProvider",
        "agentMaxSteps",
        "toolTimeoutSeconds",
        "agentTimeoutSeconds",
        "ragTopK",
        "ragMinimumScore",
        "retrievalTimeoutSeconds",
        "azureRequestTimeoutSeconds",
        "azureManagedIdentityClientId",
        "azureDatabaseBootstrapIdentityClientId",
        "azureOpenAIEndpoint",
        "azureOpenAIDeployment",
        "azureSearchEndpoint",
        "azureSearchIndexName",
        "otelEnabled",
        "otelExporter",
        "otelEndpoint",
        "azureMonitorConnectionStringSecretKey"
      ],
      "properties": {
        "environment": { "enum": ["local", "test", "staging", "production"] },
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] },
        "modelProvider": { "enum": ["fake", "azure-openai"] },
        "retrievalProvider": { "enum": ["local", "azure-search"] },
        "agentMaxSteps": { "type": "integer", "minimum": 1, "maximum": 20 },
        "toolTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "agentTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "ragTopK": { "type": "integer", "minimum": 1, "maximum": 20 },
        "ragMinimumScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "retrievalTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "azureRequestTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "azureManagedIdentityClientId": { "type": "string" },
        "azureDatabaseBootstrapIdentityClientId": { "type": "string" },
        "azureOpenAIEndpoint": { "type": "string" },
        "azureOpenAIDeployment": { "type": "string" },
        "azureSearchEndpoint": { "type": "string" },
        "azureSearchIndexName": { "type": "string" },
        "otelEnabled": { "type": "boolean" },
        "otelExporter": { "enum": ["otlp", "azure-monitor"] },
        "otelEndpoint": { "type": "string", "minLength": 1 },
        "azureMonitorConnectionStringSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authMode", "azureTokenScope", "createSecret", "url", "existingSecret", "secretKey"],
      "properties": {
        "authMode": { "enum": ["password", "azure-workload-identity"] },
        "azureTokenScope": { "type": "string", "minLength": 1 },
        "createSecret": { "type": "boolean" },
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "azurePrincipalBootstrap",
        "databaseUrl",
        "appPrincipalName",
        "appPrincipalObjectId",
        "backoffLimit",
        "serviceAccount",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "azurePrincipalBootstrap": { "type": "boolean" },
        "databaseUrl": { "type": "string" },
        "appPrincipalName": { "type": "string" },
        "appPrincipalObjectId": {
          "type": "string",
          "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "name", "automountToken", "annotations"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "automountToken": { "type": "boolean" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "fsGroupChangePolicy", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "fsGroupChangePolicy": { "enum": ["Always", "OnRootMismatch"] },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "RuntimeDefault" } }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": { "type": "array", "contains": { "const": "ALL" } }
          }
        }
      }
    },
    "resources": { "$ref": "#/definitions/resourceRequirements" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failureThreshold", "periodSeconds"],
          "properties": {
            "failureThreshold": { "type": "integer", "minimum": 1 },
            "periodSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": { "$ref": "#/definitions/httpProbe" },
        "readiness": { "$ref": "#/definitions/httpProbe" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 4 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 50, "maximum": 90 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "postgresCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "postgresCidrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9./]+$" }
        }
      }
    },
    "keyVault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "tenantId", "objects", "secretObjects", "mountPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "tenantId": { "type": "string" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["objectName"],
            "properties": {
              "objectName": { "type": "string", "minLength": 1 },
              "objectType": { "enum": ["secret", "key", "cert"] },
              "objectAlias": { "type": "string" }
            }
          }
        },
        "secretObjects": { "type": "array", "items": { "type": "object" } },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
