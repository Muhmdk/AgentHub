        "label": "Agent",
        "name": "agent",
        "query": {"query": "label_values(agenthub_agent_requests_total, agent_name)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
